generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  installateur
  coordinateurTravaux
  qualite
  direction
  admin
}

enum UserStatus {
  salarie
  sousTraitant
}

model User {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  mobile        String?  @unique
  email         String?  @unique
  passwordHash  String
  role          UserRole
  status        UserStatus?
  societe       String?
  avatarUrl     String?
  isActive      Boolean  @default(false)
  suspendu      Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Mot de passe oublié (self-service) : code à 6 chiffres haché, même
  // mécanisme que EmailVerificationCode mais stocké directement sur le
  // compte puisqu'une seule réinitialisation peut être en cours à la fois.
  resetPasswordCode     String?
  resetPasswordExpires  DateTime?
  resetPasswordAttempts Int       @default(0)

  // Verrou de connexion persistant en base (voir /auth/login) — le
  // rate-limit en mémoire (authRateLimit) est par IP et non fiable en
  // serverless (état perdu à chaque cold start) ; ce compteur, lui, résiste
  // à un brute-force distribué ou étalé dans le temps sur un même compte.
  loginFailedAttempts Int       @default(0)
  loginLockedUntil    DateTime?

  habilitations       Habilitation[]
  chantiersRattaches  ChantierInstallateur[]
  documentsTerrain    DocumentTerrain[]
  refreshTokens       RefreshToken[]
  chantiersCommeCT    Chantier[]             @relation("ChantierCoordinateurTravaux")
}

model Habilitation {
  id             String   @id @default(cuid())
  titre          String
  dateExpiration DateTime
  filePath       String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

// Code de vérification à 6 chiffres envoyé par email lors de l'inscription
// (EX-2FA) — courte durée de vie, une seule ligne active par email à la fois.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Chantier {
  id                String   @id @default(cuid())
  reference         String   @unique
  client            String
  adresse           String
  ville             String
  dateDebut         DateTime
  dateFin           DateTime
  contactNom        String
  contactTel        String
  contactEmail      String?
  horaires          String
  consignes         String   // JSON-encoded string list
  typeMonteCharge   String
  capacite          String
  niveaux           Int
  referenceAffaire  String
  syncStatus        String   @default("nouveau")
  // PV de réception, deux flux possibles :
  // - Historique : le back-office dépose un gabarit PDF (pvPdfPath), non
  //   encore validé, que l'installateur fait signer directement dessus (voir
  //   POST .../pv/signature).
  // - Depuis la refonte : formulaire interactif basé sur le gabarit officiel
  //   Vertical, réponses enregistrées en JSON dans pvReponses (voir POST
  //   .../pv/reponses et backend/src/lib/pvFormPdf.ts) — pvPdfPath reste
  //   `null` dans ce cas, c'est ce qui distingue les deux flux côté app.
  // Dans les deux cas, ce n'est qu'à la signature que pvSigne passe à true et
  // que le PDF final (signature intégrée) est enregistré dans
  // pvSignatureImagePath.
  pvPdfPath            String?
  pvReponses           String?   // JSON-encodé (formulaire interactif, voir pvFormPdf.ts)
  pvSigne              Boolean  @default(false)
  pvSigneur            String?
  pvFonctionSignataire String?
  pvSigneAt            DateTime?
  pvSignatureImagePath String?
  createdAt         DateTime @default(now())

  // Rattachement direct à un Coordinateur travaux responsable, renseigné par
  // l'Admin à la création (voir la refonte : sélecteur de CT dans le
  // formulaire admin) — optionnel, distinct de ChantierInstallateur qui
  // rattache des installateurs.
  coordinateurTravaux      User?    @relation("ChantierCoordinateurTravaux", fields: [coordinateurTravauxId], references: [id])
  coordinateurTravauxId    String?

  pointsControle      PointControle[]
  installateurs       ChantierInstallateur[]
  documentsTerrain    DocumentTerrain[]
  documentsChantier   DocumentChantier[]
  rex                 Rex[]
  notifications       Notification[]
  livretsOuvertsJson  String @default("[]") // JSON-encoded list of user ids
}

// Retour d'expérience (REX) d'un installateur sur un chantier — plusieurs
// entrées possibles par chantier (un installateur peut compléter son retour
// s'il a oublié quelque chose), voir POST/DELETE .../rex dans chantiers.ts.
model Rex {
  id            String   @id @default(cuid())
  chantier      Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId    String
  transcription String?
  audioPath     String?
  soumisAt      DateTime @default(now())
}

// Notifications internes (CT/Admin), ex. alerte de prévention quand
// l'auto-contrôle d'un chantier atteint 80% — pas de push/email, juste un
// panneau consulté dans le back-office.
model Notification {
  id         String   @id @default(cuid())
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId String
  type       String
  message    String
  lue        Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ChantierInstallateur {
  id          String   @id @default(cuid())
  chantier    Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  rattacheAt  DateTime @default(now())

  @@unique([chantierId, userId])
}

enum PointType {
  reception
  autoControle
}

enum PointStatus {
  vide
  conforme
  nonConforme
}

model PointControle {
  id            String      @id @default(cuid())
  chantier      Chantier    @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId    String
  type          PointType
  libelle       String
  categorie     String      @default("generale")
  critique      Boolean     @default(false)
  photoRequise  Boolean     @default(true)
  status        PointStatus @default(vide)
  photoPath     String?
  validePar     String?
  valideAt      DateTime?
  ordre         Int         @default(0)
}

// Modèle des listes de réception/contrôle appliqué à la création de chaque
// nouveau chantier (voir POST /chantiers) — modifiable par l'Admin (ajout,
// renommage, suppression d'items) sans toucher au code. Ne modifie jamais les
// PointControle déjà créés sur des chantiers existants.
model ChecklistTemplateItem {
  id        String    @id @default(cuid())
  type      PointType
  categorie String    @default("generale")
  libelle   String
  critique  Boolean   @default(false)
  ordre     Int       @default(0)
}

enum CategorieDocument {
  bonLivraison
  documentClient
  habilitation
  constat
  autre
}

model DocumentTerrain {
  id          String            @id @default(cuid())
  chantier    Chantier          @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId  String
  titre       String
  categorie   CategorieDocument
  filePath    String?
  auteur      User              @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  auteurId    String
  horodatage  DateTime          @default(now())
}

enum TypeDocumentChantier {
  ficheChantier
  securite
  technique
}

// Documents de référence déposés par le Coordinateur travaux (PPSPS, plans, notices...) —
// consultés en lecture seule par l'installateur (Modules 1-3), à ne pas
// confondre avec DocumentTerrain (dépôts de l'installateur lui-même sur site).
model DocumentChantier {
  id                 String               @id @default(cuid())
  chantier           Chantier             @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId         String
  type               TypeDocumentChantier
  nom                String
  // Nom du fichier tel qu'il existait sur l'ordinateur de la personne qui l'a
  // déposé (ex. "Plan_2024.pdf") — distinct de `nom` (le titre libre donné
  // par le CA), conservé pour qu'on puisse toujours identifier le fichier
  // réel même si `nom` a été renommé. Nullable : les documents déposés avant
  // ce champ n'ont pas cette information.
  nomFichierOriginal String?
  filePath           String
  createdAt          DateTime             @default(now())
}
