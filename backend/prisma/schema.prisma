generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  installateur
  chargeAffaires
  qualite
  direction
  admin
}

enum UserStatus {
  salarie
  sousTraitant
}

model User {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  mobile        String?  @unique
  email         String?  @unique
  passwordHash  String
  role          UserRole
  status        UserStatus?
  societe       String?
  isActive      Boolean  @default(false)
  suspendu      Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Mot de passe oublié (self-service) : code à 6 chiffres haché, même
  // mécanisme que EmailVerificationCode mais stocké directement sur le
  // compte puisqu'une seule réinitialisation peut être en cours à la fois.
  resetPasswordCode    String?
  resetPasswordExpires DateTime?

  habilitations       Habilitation[]
  chantiersRattaches  ChantierInstallateur[]
  documentsTerrain    DocumentTerrain[]
  refreshTokens       RefreshToken[]
  chantiersCommeCA    Chantier[]             @relation("ChantierChargeAffaires")
}

model Habilitation {
  id             String   @id @default(cuid())
  titre          String
  dateExpiration DateTime
  filePath       String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
}

// Code de vérification à 6 chiffres envoyé par email lors de l'inscription
// (EX-2FA) — courte durée de vie, une seule ligne active par email à la fois.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Chantier {
  id                String   @id @default(cuid())
  reference         String   @unique
  client            String
  adresse           String
  ville             String
  dateDebut         DateTime
  dateFin           DateTime
  contactNom        String
  contactTel        String
  horaires          String
  consignes         String   // JSON-encoded string list
  typeMonteCharge   String
  capacite          String
  niveaux           Int
  referenceAffaire  String
  syncStatus        String   @default("nouveau")
  rexValide         Boolean  @default(false)
  rexTranscription  String?
  rexAudioPath      String?
  rexSoumisAt       DateTime?
  // PV de réception : le back-office dépose un gabarit PDF (pvPdfPath), qui
  // n'est PAS encore validé — l'installateur le consulte, fait signer le
  // client et renseigne son nom/sa fonction ; ce n'est qu'à ce moment que
  // pvSigne passe à true et que le PDF final (signature intégrée) est
  // enregistré dans pvSignatureImagePath. Voir refonte du workflow PV.
  pvPdfPath            String?
  pvSigne              Boolean  @default(false)
  pvSigneur            String?
  pvFonctionSignataire String?
  pvSigneAt            DateTime?
  pvSignatureImagePath String?
  createdAt         DateTime @default(now())

  // Rattachement direct à un CA responsable, renseigné par l'Admin à la
  // création (voir la refonte : sélecteur de CA dans le formulaire admin) —
  // optionnel, distinct de ChantierInstallateur qui rattache des installateurs.
  chargeAffaires      User?    @relation("ChantierChargeAffaires", fields: [chargeAffairesId], references: [id])
  chargeAffairesId    String?

  pointsControle      PointControle[]
  installateurs       ChantierInstallateur[]
  documentsTerrain    DocumentTerrain[]
  documentsChantier   DocumentChantier[]
  notifications       Notification[]
  livretsOuvertsJson  String @default("[]") // JSON-encoded list of user ids
}

// Notifications internes (CA/Admin), ex. alerte de prévention quand
// l'auto-contrôle d'un chantier atteint 80% — pas de push/email, juste un
// panneau consulté dans le back-office.
model Notification {
  id         String   @id @default(cuid())
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId String
  type       String
  message    String
  lue        Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ChantierInstallateur {
  id          String   @id @default(cuid())
  chantier    Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  rattacheAt  DateTime @default(now())

  @@unique([chantierId, userId])
}

enum PointType {
  reception
  autoControle
}

enum PointStatus {
  vide
  conforme
  nonConforme
}

model PointControle {
  id            String      @id @default(cuid())
  chantier      Chantier    @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId    String
  type          PointType
  libelle       String
  categorie     String      @default("generale")
  critique      Boolean     @default(false)
  photoRequise  Boolean     @default(true)
  status        PointStatus @default(vide)
  photoPath     String?
  validePar     String?
  valideAt      DateTime?
  ordre         Int         @default(0)
}

enum CategorieDocument {
  bonLivraison
  documentClient
  habilitation
  constat
  autre
}

model DocumentTerrain {
  id          String            @id @default(cuid())
  chantier    Chantier          @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId  String
  titre       String
  categorie   CategorieDocument
  filePath    String?
  auteur      User              @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  auteurId    String
  horodatage  DateTime          @default(now())
}

enum TypeDocumentChantier {
  ficheChantier
  securite
  technique
}

// Documents de référence déposés par le CA (PPSPS, plans, notices...) —
// consultés en lecture seule par l'installateur (Modules 1-3), à ne pas
// confondre avec DocumentTerrain (dépôts de l'installateur lui-même sur site).
model DocumentChantier {
  id                 String               @id @default(cuid())
  chantier           Chantier             @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId         String
  type               TypeDocumentChantier
  nom                String
  // Nom du fichier tel qu'il existait sur l'ordinateur de la personne qui l'a
  // déposé (ex. "Plan_2024.pdf") — distinct de `nom` (le titre libre donné
  // par le CA), conservé pour qu'on puisse toujours identifier le fichier
  // réel même si `nom` a été renommé. Nullable : les documents déposés avant
  // ce champ n'ont pas cette information.
  nomFichierOriginal String?
  filePath           String
  createdAt          DateTime             @default(now())
}
