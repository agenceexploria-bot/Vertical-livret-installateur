# Copiez ce fichier en .env (`cp .env.example .env`) et remplissez les
# valeurs réelles. Voir le README.md racine, section "Installation &
# configuration locale", pour le détail de chaque variable et où l'obtenir.

# --- Base de données (Postgres — Neon recommandé, plan gratuit) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base séparée utilisée uniquement par `npm test` (jamais la même que
# DATABASE_URL : les tests font un reset complet du schéma dessus).
TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"

# --- Authentification (JWT) ---
# Deux chaînes aléatoires longues et distinctes, ex. générées avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# --- Stockage fichiers (Vercel Blob) ---
# Vercel > votre projet > Storage > Create Database > Blob, puis copiez le
# token depuis Settings > Environment Variables.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Serveur local ---
PORT=3000

# --- SMTP (obligatoire — 2FA par email à l'inscription, voir server.ts) ---
# Avec Gmail : SMTP_USER = votre adresse Gmail, SMTP_PASS = un "mot de passe
# d'application" (https://myaccount.google.com/apppasswords), pas votre mot
# de passe habituel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=exemple@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Vertical <exemple@gmail.com>"

# --- Pusher (optionnel — synchronisation temps réel, voir lib/pusher.ts) ---
# Créez une app sur https://dashboard.pusher.com (Channels, plan gratuit) puis
# copiez ces 4 valeurs depuis App Keys. PUSHER_KEY et PUSHER_CLUSTER doivent
# aussi être renseignés côté Flutter (lib/core/realtime_config.dart) — ce sont
# des valeurs publiques, jamais PUSHER_SECRET ni PUSHER_APP_ID. Sans ces
# variables, l'app fonctionne normalement mais sans mise à jour temps réel.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
